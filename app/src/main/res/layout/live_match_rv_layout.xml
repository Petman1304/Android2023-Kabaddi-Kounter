<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_height="wrap_content"
    android:layout_width="match_parent"
    android:layout_margin="8dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp"
        android:background="@drawable/layout_border"
        >

        <TextView
            android:id="@+id/layoutScoreA"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:text="0"
            android:textSize="32sp"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/layoutTeamA"
            app:layout_constraintEnd_toStartOf="@id/subscribeBtn"
            app:layout_constraintTop_toTopOf="@id/layoutTeamA"
            app:layout_constraintBottom_toTopOf="@id/layoutScoreB"/>

        <TextView
            android:id="@+id/layoutScoreB"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            android:text="99"
            android:textSize="32sp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="@id/layoutScoreA"
            app:layout_constraintTop_toBottomOf="@id/layoutScoreA"
            app:layout_constraintEnd_toEndOf="@id/layoutScoreA"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/layoutTeamA"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="Team A"
            android:textSize="24sp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutScoreA"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/layoutTeamB"/>

        <TextView
            android:id="@+id/layoutTeamB"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:text="Team B"
            android:textSize="24sp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layoutScoreB"
            app:layout_constraintTop_toBottomOf="@id/layoutTeamA"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="LIVE"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/subscribeBtn"
            app:layout_constraintStart_toStartOf="@id/subscribeBtn"
            app:layout_constraintEnd_toEndOf="@id/subscribeBtn"
            />
        <ImageButton
            android:id="@+id/subscribeBtn"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src ="@drawable/ic_live_match_black_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/layoutScoreA"
            android:layout_marginHorizontal="16dp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
